# Copy to terraform.tfvars and fill in with real values before `terraform apply`.

aws_region  = "us-east-1"
aws_profile = "default"

vpc_id              = "vpc-xxxxxxxxxxxxxxxxx"
subnet_ids          = ["subnet-xxxxxxxxxxxxxxxxx", "subnet-yyyyyyyyyyyyyyyyy"]
security_group_ids  = ["sg-xxxxxxxxxxxxxxxxx"]

model_data_url            = "s3://my-bucket/iris/model.tar.gz"
model_artifact_bucket_arn = "arn:aws:s3:::my-bucket"

# This stack doesn't manage the image - build and push ../container/ to an
# existing ECR repo yourself before applying, see variables.tf for the
# exact commands, then paste the full image URI (with tag) here.
container_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/my-repo:latest"

tags = {
  project = "iris-ic"
}
